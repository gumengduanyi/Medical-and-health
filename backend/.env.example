APP_NAME=智能健康管理 API
APP_ENV=development
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
UPLOAD_DIR=./uploads
# 设置为可被手机访问的局域网地址，例如 http://192.168.1.100:8000
PUBLIC_BASE_URL=
AUTH_TOKEN_SECRET=change-me-in-production
AUTH_TOKEN_TTL_SECONDS=604800
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/health_assistant
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION=health_documents
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_ENABLED=false
EMBEDDING_MODEL=bge-m3
RERANKER_ENABLED=false
RAG_MIN_SCORE=1.0
RAG_TOP_K=4
LEAFLET_OUTPUT_DIR=./uploads/leaflets
LEAFLET_BROWSER_TIMEOUT_SECONDS=30
