APP_NAME=智能健康管理 API
APP_ENV=development
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
UPLOAD_DIR=./uploads
AUTH_TOKEN_SECRET=change-me-in-production
AUTH_TOKEN_TTL_SECONDS=604800
ASSISTANT_NAME=健康助手 AI
ASSISTANT_ROLE=本项目的医疗健康资料整理助手
ASSISTANT_SCOPE=个人健康档案、体检报告、药品记录、药品说明书和项目健康知识库
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/health_assistant
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION=health_documents
WEB_SEARCH_ENABLED=true
WEB_SEARCH_URL=http://127.0.0.1:8080/search
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_DOMAINS=gov.cn,nhc.gov.cn,nmpa.gov.cn,who.int,cdc.gov,mayoclinic.org,medlineplus.gov
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_ENABLED=false
EMBEDDING_MODEL=bge-m3
RERANKER_ENABLED=false
RAG_MIN_SCORE=1.0
RAG_TOP_K=4
LEAFLET_OUTPUT_DIR=./uploads/leaflets
LEAFLET_BROWSER_TIMEOUT_SECONDS=30
LEAFLET_BROWSER_READY_TIMEOUT_SECONDS=8
LEAFLET_BROWSER_USER_DATA_DIR=./runtime/leaflet-browser
# 可选：指定本机 Chrome/Chromium 路径；留空使用 Playwright Chromium
LEAFLET_BROWSER_EXECUTABLE_PATH=
LEAFLET_BROWSER_HEADLESS=true
LEAFLET_BROWSER_MAX_RETRIES=1
# 允许审核说明书的用户 ID，多个 ID 用逗号分隔
LEAFLET_ADMIN_USER_IDS=
