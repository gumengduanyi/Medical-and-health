VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION=health_documents
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
RAG_MIN_SCORE=1.0
RAG_TOP_K=4
